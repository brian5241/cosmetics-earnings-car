# 언어 통계에서 제외할 생성물
#
# report.html 은 src/13_build_report.py 가 만들어내는 산출물이다.
# 470KB 로 저장소에서 가장 큰 파일이라, 그대로 두면 GitHub 이
# 이 저장소의 주 언어를 HTML 로 표시한다.
# linguist-generated 로 표시하면 언어 통계에서 빠지고 diff 도 접힌다.
report.html linguist-generated=true

# 데이터 파일도 언어 통계 대상이 아니다
data/*.csv linguist-generated=true

# 줄바꿈: 저장소에는 LF 로 통일하고 체크아웃 시 OS 관례를 따른다
* text=auto
*.py   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.ipynb text eol=lf
